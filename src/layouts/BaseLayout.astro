---
import Navbar from "../components/Navbar.astro";
import TermTooltipRoot from "../components/TermTooltipRoot.astro";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    lang: string;
}

const {
    title,
    description = "Thư viện kiến thức Toán học phổ thông song ngữ Việt - Anh.",
    lang,
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <title>{title} · Lingualearn</title>

        <script is:inline>
            try {
                if ("scrollRestoration" in history) {
                    history.scrollRestoration = "manual";
                }
                if (sessionStorage.getItem("lingualearn:scrollY") !== null) {
                    document.documentElement.style.visibility = "hidden";
                }
            } catch (e) {}
        </script>
    </head>
    <body>
        <header>
            <Navbar lang={lang} pathname={pathname} />
        </header>

        <main>
            <slot />
        </main>

        <footer class="site-footer">
            <div class="container">
                <p>
                    © {new Date().getFullYear()} Lingualearn — Thư viện Toán học
                    song ngữ dành cho học sinh Việt Nam.
                </p>
            </div>
        </footer>

        <TermTooltipRoot />

        <script is:inline>
            (function () {
                try {
                    var raw = sessionStorage.getItem("lingualearn:scrollY");
                    if (raw !== null) {
                        sessionStorage.removeItem("lingualearn:scrollY");
                        window.scrollTo(0, parseInt(raw, 10) || 0);
                    }
                } finally {
                    document.documentElement.style.visibility = "";
                }
            })();
        </script>
    </body>
</html>

<style>
    body {
        padding-top: var(--header-height);
    }
    main {
        min-height: calc(100vh - var(--header-height) - 80px);
    }
    .site-footer {
        border-top: 1px solid var(--color-border);
        padding-block: 1.5rem;
        margin-top: 3rem;
        font-size: 0.85rem;
        color: var(--color-text-muted);
        text-align: center;
    }
</style>
