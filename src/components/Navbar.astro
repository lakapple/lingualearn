---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SearchBox from "./SearchBox.astro";

interface Props {
    lang: string;
    pathname: string;
}
const { lang, pathname } = Astro.props;

const navLinks = [
    { label: lang === "vi" ? "Toán 10" : "Grade 10", href: `/${lang}/lop-10` },
    { label: lang === "vi" ? "Toán 11" : "Grade 11", href: `/${lang}/lop-11` },
    { label: lang === "vi" ? "Toán 12" : "Grade 12", href: `/${lang}/lop-12` },
    {
        label: lang === "vi" ? "Thuật ngữ Wiki" : "Wiki Glossary",
        href: `/${lang}/concepts`,
    },
];
---

<div class="navbar">
    <div class="container navbar__inner">
        <a href={`/${lang}`} class="navbar__logo">
            Lingual<span>earn</span>
        </a>

        <nav class="navbar__links" aria-label="Điều hướng chính">
            {navLinks.map((link) => (
                <a href={link.href}>{link.label}</a>
            ))}
        </nav>

        <SearchBox lang={lang} />

        <LanguageSwitcher lang={lang} pathname={pathname} />
    </div>
</div>

<style>
    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        height: var(--header-height);
        background: var(--color-bg);
        border-bottom: 1px solid var(--color-border);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }

    .navbar__inner {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .navbar__logo {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--color-text);
        white-space: nowrap;
    }
    .navbar__logo span {
        color: var(--color-accent);
    }
    .navbar__logo:hover {
        text-decoration: none;
    }

    .navbar__links {
        display: flex;
        gap: 1rem;
        flex-shrink: 0;
    }
    .navbar__links a {
        font-size: 0.9rem;
        color: var(--color-text);
        padding: 0.4rem 0.25rem;
    }
    .navbar__links a:hover {
        color: var(--color-accent);
        text-decoration: none;
    }

    @media (max-width: 768px) {
        .navbar__links {
            display: none;
        }
    }
</style>
