---
// src/components/SearchBox.astro
interface Props {
    lang: string;
}

const { lang } = Astro.props;

const t = {
    vi: {
        placeholder: "Tìm kiếm bài học, định lý, tag... (/)",
        all: "Tất cả",
        lessons: "Bài học",
        concepts: "Thuật ngữ",
        grades: "Khối lớp:",
        gradeAll: "Tất cả lớp",
        grade10: "Lớp 10",
        grade11: "Lớp 11",
        grade12: "Lớp 12",
        suggestionsTitle: "Gợi ý tìm kiếm phổ biến",
        noResults: "Không tìm thấy kết quả phù hợp",
        noResultsDesc: "Hãy thử kiểm tra lại chính tả hoặc tìm bằng từ khóa ngắn gọn hơn (có hoặc không dấu).",
        viewAll: "Xem toàn bộ trang kết quả",
        foundResults: "kết quả",
        kbdNav: "di chuyển",
        kbdSelect: "chọn",
        kbdClose: "đóng",
        loading: "Đang tải dữ liệu...",
    },
    en: {
        placeholder: "Search lessons, theorems, tags... (/)",
        all: "All",
        lessons: "Lessons",
        concepts: "Concepts",
        grades: "Grades:",
        gradeAll: "All grades",
        grade10: "Grade 10",
        grade11: "Grade 11",
        grade12: "Grade 12",
        suggestionsTitle: "Popular suggestions",
        noResults: "No matching results found",
        noResultsDesc: "Check your spelling or try shorter, broader keywords.",
        viewAll: "View all results on search page",
        foundResults: "results",
        kbdNav: "navigate",
        kbdSelect: "select",
        kbdClose: "close",
        loading: "Loading data...",
    },
}[lang] ?? {
    placeholder: "Search...",
    all: "All",
    lessons: "Lessons",
    concepts: "Concepts",
    grades: "Grades:",
    gradeAll: "All",
    grade10: "Grade 10",
    grade11: "Grade 11",
    grade12: "Grade 12",
    suggestionsTitle: "Suggestions",
    noResults: "No results",
    noResultsDesc: "Try broader keywords",
    viewAll: "View all results",
    foundResults: "results",
    kbdNav: "navigate",
    kbdSelect: "select",
    kbdClose: "close",
    loading: "Loading...",
};

const popularSuggestions = lang === "vi"
    ? ["Mặt cầu", "Đạo hàm", "Tích phân", "Véc-tơ", "Cấp số cộng", "Xác suất", "Mệnh đề", "Tập hợp"]
    : ["Sphere", "Derivative", "Integral", "Vector", "Arithmetic progression", "Probability", "Proposition", "Sets"];
---

<div class="search-box" id="search-box-root" data-lang={lang}>
    <form
        class="search-box__form"
        role="search"
        action={`/${lang}/search`}
        method="get"
        id="search-box-form"
    >
        <span class="search-box__icon" aria-hidden="true">
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
        </span>

        <input
            type="search"
            name="q"
            id="search-box-input"
            class="search-box__input"
            placeholder={t.placeholder}
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            aria-label="Search"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="search-box-dropdown"
        />

        <button
            type="button"
            id="search-box-clear"
            class="search-box__clear"
            aria-label="Clear search input"
            hidden
        >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
        </button>

        <kbd class="search-box__kbd" aria-hidden="true" title="Nhấn / để tìm kiếm">/</kbd>
    </form>

    <!-- Eager Search Dropdown / Tab Overlay -->
    <div
        id="search-box-dropdown"
        class="search-box__dropdown"
        role="region"
        aria-label="Kết quả tìm kiếm"
        hidden
    >
        <!-- Filter Tabs Header -->
        <div class="search-box__tabs-bar">
            <div class="search-box__tabs" role="tablist">
                <button
                    type="button"
                    class="search-tab is-active"
                    role="tab"
                    aria-selected="true"
                    data-filter-tab="all"
                >
                    <span>{t.all}</span>
                    <span class="search-tab__count" id="count-all">0</span>
                </button>
                <button
                    type="button"
                    class="search-tab"
                    role="tab"
                    aria-selected="false"
                    data-filter-tab="lesson"
                >
                    <span>{t.lessons}</span>
                    <span class="search-tab__count" id="count-lesson">0</span>
                </button>
                <button
                    type="button"
                    class="search-tab"
                    role="tab"
                    aria-selected="false"
                    data-filter-tab="concept"
                >
                    <span>{t.concepts}</span>
                    <span class="search-tab__count" id="count-concept">0</span>
                </button>
            </div>

            <!-- Grade Filter Sub-bar (for lessons) -->
            <div class="search-box__grades" id="search-box-grades">
                <span class="search-box__grades-label">{t.grades}</span>
                <button type="button" class="grade-chip is-active" data-grade-chip="all">{t.gradeAll}</button>
                <button type="button" class="grade-chip" data-grade-chip="10">{t.grade10}</button>
                <button type="button" class="grade-chip" data-grade-chip="11">{t.grade11}</button>
                <button type="button" class="grade-chip" data-grade-chip="12">{t.grade12}</button>
            </div>
        </div>

        <!-- Content Area: Suggestions, Results, or Empty State -->
        <div class="search-box__content" id="search-box-content">
            <!-- Initial Suggestions State -->
            <div class="search-box__suggestions" id="search-suggestions">
                <div class="suggestions-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
                    </svg>
                    <span>{t.suggestionsTitle}</span>
                </div>
                <div class="suggestions-chips">
                    {popularSuggestions.map((s) => (
                        <button type="button" class="suggestion-chip" data-suggestion={s}>
                            {s}
                        </button>
                    ))}
                </div>
            </div>

            <!-- Live Results List -->
            <ul
                class="search-results-list"
                id="search-results-list"
                role="listbox"
                hidden
            >
                <!-- Rendered dynamically via JS -->
            </ul>

            <!-- Empty State -->
            <div class="search-box__empty" id="search-empty" hidden>
                <div class="search-box__empty-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        <line x1="8" y1="11" x2="14" y2="11" />
                    </svg>
                </div>
                <p class="search-box__empty-title">{t.noResults}</p>
                <p class="search-box__empty-desc">{t.noResultsDesc}</p>
            </div>
        </div>

        <!-- Footer Bar with navigation shortcuts and link to full page -->
        <div class="search-box__footer">
            <div class="search-box__summary" id="search-summary">
                <span id="search-summary-text">0 {t.foundResults}</span>
            </div>

            <div class="search-box__hints">
                <span class="hint-item"><kbd>↑</kbd><kbd>↓</kbd> {t.kbdNav}</span>
                <span class="hint-item"><kbd>↵</kbd> {t.kbdSelect}</span>
                <span class="hint-item"><kbd>esc</kbd> {t.kbdClose}</span>
            </div>

            <a href={`/${lang}/search`} class="search-box__view-all" id="search-view-all">
                {t.viewAll} →
            </a>
        </div>
    </div>
</div>

<style>
    .search-box {
        position: relative;
        flex: 1;
        max-width: 420px;
    }

    .search-box__form {
        position: relative;
        display: flex;
        align-items: center;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        padding-inline: 0.75rem;
        background: var(--color-bg-subtle);
        transition: border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
    }

    .search-box__form:focus-within {
        border-color: var(--color-accent);
        background: var(--color-bg);
        box-shadow: 0 0 0 3px rgba(51, 102, 204, 0.15);
    }

    .search-box__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        margin-right: 0.45rem;
        flex-shrink: 0;
    }

    .search-box__input {
        flex: 1;
        border: none;
        background: transparent;
        padding-block: 0.45rem;
        font-size: 0.86rem;
        color: var(--color-text);
        outline: none;
        min-width: 0;
    }

    .search-box__input::-webkit-search-cancel-button {
        display: none;
    }

    .search-box__clear {
        border: none;
        background: rgba(0, 0, 0, 0.06);
        color: var(--color-text-muted);
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
        margin-right: 0.35rem;
        transition: background-color 0.15s, color 0.15s;
    }
    .search-box__clear:hover {
        background: rgba(0, 0, 0, 0.12);
        color: var(--color-text);
    }

    .search-box__kbd {
        font-size: 0.7rem;
        line-height: 1;
        padding: 0.15rem 0.35rem;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        background: var(--color-bg);
        color: var(--color-text-muted);
        font-family: inherit;
        user-select: none;
    }

    /* Eager Search Dropdown / Tab Overlay */
    .search-box__dropdown {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: -80px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.14), 0 3px 8px rgba(0, 0, 0, 0.05);
        z-index: 1000;
        overflow: hidden;
        animation: searchFadeIn 0.15s ease-out;
        display: flex;
        flex-direction: column;
    }

    .search-box__dropdown[hidden] {
        display: none !important;
    }

    @keyframes searchFadeIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Tabs Bar Header */
    .search-box__tabs-bar {
        background: var(--color-bg-subtle);
        border-bottom: 1px solid var(--color-border);
        padding: 0.6rem 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .search-box__tabs {
        display: flex;
        gap: 0.35rem;
    }

    .search-tab {
        border: 1px solid transparent;
        background: transparent;
        padding: 0.3rem 0.65rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-text-muted);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.15s ease;
    }

    .search-tab:hover {
        color: var(--color-text);
        background: rgba(0, 0, 0, 0.04);
    }

    .search-tab.is-active {
        background: var(--color-accent);
        color: #ffffff;
    }

    .search-tab__count {
        font-size: 0.7rem;
        padding: 0.05rem 0.35rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.07);
        color: inherit;
    }

    .search-tab.is-active .search-tab__count {
        background: rgba(255, 255, 255, 0.25);
    }

    /* Grade Filter Sub-bar */
    .search-box__grades {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.75rem;
        flex-wrap: wrap;
    }

    .search-box__grades-label {
        color: var(--color-text-muted);
        margin-right: 0.2rem;
        font-weight: 500;
    }

    .grade-chip {
        border: 1px solid var(--color-border);
        background: var(--color-bg);
        color: var(--color-text-muted);
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        font-size: 0.72rem;
        cursor: pointer;
        transition: all 0.12s;
    }

    .grade-chip:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }

    .grade-chip.is-active {
        background: #3366cc;
        border-color: #3366cc;
        color: #ffffff;
        font-weight: 600;
    }

    /* Content Area */
    .search-box__content {
        max-height: 380px;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    /* Suggestions */
    .search-box__suggestions {
        padding: 1rem;
    }

    .suggestions-header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.7rem;
    }

    .suggestions-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .suggestion-chip {
        border: 1px solid var(--color-border);
        background: var(--color-bg-subtle);
        color: var(--color-text);
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .suggestion-chip:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background: rgba(51, 102, 204, 0.05);
    }

    /* Results List */
    .search-results-list {
        list-style: none;
        margin: 0;
        padding: 0.35rem;
    }

    :global(.search-result-item) {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.7rem 0.85rem;
        border-radius: 8px;
        color: var(--color-text);
        text-decoration: none;
        transition: background 0.12s, transform 0.12s;
        border-left: 3px solid transparent;
    }

    :global(.search-result-item:hover),
    :global(.search-result-item.is-selected) {
        background: var(--color-bg-subtle);
        border-left-color: var(--color-accent);
        text-decoration: none;
    }

    :global(.search-result-item__main) {
        flex: 1;
        min-width: 0;
    }

    :global(.search-result-item__header) {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.25rem;
        flex-wrap: wrap;
    }

    :global(.search-badge) {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        letter-spacing: 0.03em;
    }

    :global(.search-badge--lesson) {
        background: rgba(51, 102, 204, 0.12);
        color: var(--color-accent);
    }

    :global(.search-badge--concept) {
        background: rgba(147, 51, 234, 0.12);
        color: #7c3aed;
    }

    :global(.search-badge--grade) {
        background: rgba(0, 0, 0, 0.06);
        color: var(--color-text-muted);
    }

    :global(.search-result-item__title) {
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--color-text);
        line-height: 1.35;
    }

    :global(.search-result-item:hover .search-result-item__title),
    :global(.search-result-item.is-selected .search-result-item__title) {
        color: var(--color-accent);
    }

    :global(.search-result-item__desc) {
        font-size: 0.8rem;
        color: var(--color-text-muted);
        margin: 0.2rem 0 0.35rem 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    :global(.search-result-item__tags) {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    :global(.search-mini-tag) {
        font-size: 0.7rem;
        padding: 0.05rem 0.4rem;
        border-radius: 4px;
        background: rgba(0, 0, 0, 0.04);
        color: var(--color-text-muted);
    }

    :global(.search-result-item__arrow) {
        color: var(--color-text-muted);
        font-size: 1rem;
        opacity: 0.4;
        flex-shrink: 0;
        padding-top: 0.3rem;
        transition: opacity 0.12s, transform 0.12s;
    }

    :global(.search-result-item:hover .search-result-item__arrow),
    :global(.search-result-item.is-selected .search-result-item__arrow) {
        opacity: 1;
        transform: translateX(3px);
        color: var(--color-accent);
    }

    :global(mark.search-highlight) {
        background: rgba(254, 240, 138, 0.7);
        color: inherit;
        border-radius: 2px;
        padding-inline: 0.15rem;
    }

    /* Empty state */
    .search-box__empty {
        padding: 2.2rem 1rem;
        text-align: center;
        color: var(--color-text-muted);
    }

    .search-box__empty-icon {
        margin-bottom: 0.5rem;
        opacity: 0.6;
    }

    .search-box__empty-title {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--color-text);
        margin: 0 0 0.35rem 0;
    }

    .search-box__empty-desc {
        font-size: 0.82rem;
        max-width: 320px;
        margin-inline: auto;
        line-height: 1.4;
    }

    /* Footer */
    .search-box__footer {
        border-top: 1px solid var(--color-border);
        background: var(--color-bg-subtle);
        padding: 0.5rem 0.85rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.76rem;
        color: var(--color-text-muted);
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .search-box__hints {
        display: flex;
        gap: 0.6rem;
    }

    .hint-item {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .hint-item kbd {
        font-family: inherit;
        padding: 0.08rem 0.3rem;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 3px;
        font-size: 0.68rem;
    }

    .search-box__view-all {
        color: var(--color-accent);
        font-weight: 600;
        text-decoration: none;
    }
    .search-box__view-all:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .search-box {
            max-width: none;
            width: 100%;
        }

        .search-box__dropdown {
            position: fixed;
            top: var(--header-height);
            left: 0.5rem;
            right: 0.5rem;
            max-width: none;
            max-height: calc(100vh - var(--header-height) - 1rem);
        }

        .search-box__hints {
            display: none;
        }
    }
</style>

<script>
    import { searchItems, highlightMatch, removeVietnameseTones } from "../lib/search-utils.js";

    interface SearchIndexItem {
        id: string;
        type: "lesson" | "concept";
        lang: string;
        title: string;
        description: string;
        tags: string[];
        grade: number | null;
        url: string;
        phonetic?: string;
        summary?: string;
        order?: number;
    }

    function initSearchBox() {
        const root = document.getElementById("search-box-root");
        if (!root) return;

        const lang = root.dataset.lang || "vi";
        const form = document.getElementById("search-box-form") as HTMLFormElement;
        const input = document.getElementById("search-box-input") as HTMLInputElement;
        const clearBtn = document.getElementById("search-box-clear") as HTMLButtonElement;
        const dropdown = document.getElementById("search-box-dropdown") as HTMLElement;
        const resultsList = document.getElementById("search-results-list") as HTMLUListElement;
        const emptyState = document.getElementById("search-empty") as HTMLElement;
        const suggestionsState = document.getElementById("search-suggestions") as HTMLElement;
        const gradesBar = document.getElementById("search-box-grades") as HTMLElement;
        const summaryText = document.getElementById("search-summary-text") as HTMLElement;
        const countAll = document.getElementById("count-all") as HTMLElement;
        const countLesson = document.getElementById("count-lesson") as HTMLElement;
        const countConcept = document.getElementById("count-concept") as HTMLElement;
        const viewAllLink = document.getElementById("search-view-all") as HTMLAnchorElement;

        let indexData: SearchIndexItem[] | null = null;
        let isFetchingIndex = false;
        let currentFilterTab = "all";
        let currentFilterGrade = "all";
        let currentResults: Array<{ item: SearchIndexItem; score: number; queryTokens: string[] }> = [];
        let selectedIndex = -1;

        async function ensureIndexLoaded() {
            if (indexData) return indexData;
            if (isFetchingIndex) {
                while (isFetchingIndex) {
                    await new Promise((r) => setTimeout(r, 50));
                }
                return indexData;
            }
            try {
                isFetchingIndex = true;
                const res = await fetch("/search-index.json");
                if (!res.ok) throw new Error("Failed to load search index");
                indexData = await res.json();
            } catch (err) {
                console.error("Failed to load search index:", err);
                indexData = [];
            } finally {
                isFetchingIndex = false;
            }
            return indexData;
        }

        function openDropdown() {
            dropdown.hidden = false;
            input.setAttribute("aria-expanded", "true");
            ensureIndexLoaded();
        }

        function closeDropdown() {
            dropdown.hidden = true;
            input.setAttribute("aria-expanded", "false");
            selectedIndex = -1;
            updateSelection();
        }

        function updateSelection() {
            const items = resultsList.querySelectorAll<HTMLAnchorElement>(".search-result-item");
            items.forEach((item, idx) => {
                if (idx === selectedIndex) {
                    item.classList.add("is-selected");
                    item.setAttribute("aria-selected", "true");
                    item.scrollIntoView({ block: "nearest" });
                } else {
                    item.classList.remove("is-selected");
                    item.setAttribute("aria-selected", "false");
                }
            });
        }

        async function performSearch() {
            const query = input.value.trim();
            clearBtn.hidden = query.length === 0;

            if (viewAllLink) {
                viewAllLink.href = `/${lang}/search?q=${encodeURIComponent(query)}`;
            }

            if (!query) {
                // Hiển thị gợi ý ban đầu
                suggestionsState.hidden = false;
                resultsList.hidden = true;
                emptyState.hidden = true;
                currentResults = [];
                selectedIndex = -1;
                countAll.textContent = "0";
                countLesson.textContent = "0";
                countConcept.textContent = "0";
                summaryText.textContent = lang === "vi" ? "Gợi ý tìm kiếm" : "Popular suggestions";
                return;
            }

            suggestionsState.hidden = true;
            const data = await ensureIndexLoaded();
            if (!data) return;

            // Tính số lượng cho các tab
            const allMatches = searchItems(data, query, { lang, filterType: "all", filterGrade: "all" });
            const lessonMatches = allMatches.filter((r) => r.item.type === "lesson");
            const conceptMatches = allMatches.filter((r) => r.item.type === "concept");

            countAll.textContent = String(allMatches.length);
            countLesson.textContent = String(lessonMatches.length);
            countConcept.textContent = String(conceptMatches.length);

            // Lọc theo tab hiện tại và grade hiện tại
            currentResults = searchItems(data, query, {
                lang,
                filterType: currentFilterTab,
                filterGrade: currentFilterGrade,
            });

            selectedIndex = -1;

            if (currentResults.length === 0) {
                resultsList.hidden = true;
                emptyState.hidden = false;
                summaryText.textContent = `0 ${lang === "vi" ? "kết quả" : "results"}`;
            } else {
                emptyState.hidden = true;
                resultsList.hidden = false;
                summaryText.textContent = `${currentResults.length} ${lang === "vi" ? "kết quả" : "results"}`;

                // Render danh sách kết quả
                resultsList.innerHTML = currentResults
                    .slice(0, 30) // tối đa 30 kết quả để mượt mà
                    .map(({ item, queryTokens }, idx) => {
                        const titleHighlighted = highlightMatch(item.title, queryTokens);
                        const descHighlighted = highlightMatch(item.description || item.summary || "", queryTokens);
                        const badgeType = item.type === "lesson"
                            ? `<span class="search-badge search-badge--lesson">${lang === "vi" ? "Bài học" : "Lesson"}</span>`
                            : `<span class="search-badge search-badge--concept">${lang === "vi" ? "Thuật ngữ" : "Wiki"}</span>`;
                        const gradeBadge = item.grade
                            ? `<span class="search-badge search-badge--grade">${lang === "vi" ? `Lớp ${item.grade}` : `Grade ${item.grade}`}</span>`
                            : "";
                        const tagsHtml = (item.tags || [])
                            .slice(0, 3)
                            .map((tag) => `<span class="search-mini-tag">${highlightMatch(tag, queryTokens)}</span>`)
                            .join("");

                        return `
                            <li>
                                <a
                                    href="${item.url}"
                                    class="search-result-item"
                                    role="option"
                                    data-index="${idx}"
                                    aria-selected="false"
                                >
                                    <div class="search-result-item__main">
                                        <div class="search-result-item__header">
                                            ${badgeType}
                                            ${gradeBadge}
                                            <div class="search-result-item__title">${titleHighlighted}</div>
                                        </div>
                                        ${descHighlighted ? `<p class="search-result-item__desc">${descHighlighted}</p>` : ""}
                                        ${tagsHtml ? `<div class="search-result-item__tags">${tagsHtml}</div>` : ""}
                                    </div>
                                    <span class="search-result-item__arrow" aria-hidden="true">→</span>
                                </a>
                            </li>
                        `;
                    })
                    .join("");
            }
        }

        // Lắng nghe sự kiện gõ phím tức thì (Eager Search)
        input.addEventListener("input", () => {
            openDropdown();
            performSearch();
        });

        input.addEventListener("focus", () => {
            openDropdown();
            performSearch();
        });

        // Xóa ô nhập
        clearBtn.addEventListener("click", () => {
            input.value = "";
            input.focus();
            performSearch();
        });

        // Click ngoài để đóng
        document.addEventListener("click", (e) => {
            if (!root.contains(e.target as Node)) {
                closeDropdown();
            }
        });

        // Phím tắt bàn phím toàn trang: bấm '/' để focus vào ô tìm kiếm
        document.addEventListener("keydown", (e) => {
            const activeEl = document.activeElement;
            const isTyping =
                activeEl &&
                (activeEl.tagName === "INPUT" ||
                 activeEl.tagName === "TEXTAREA" ||
                 (activeEl as HTMLElement).isContentEditable);

            if (e.key === "/" && !isTyping) {
                e.preventDefault();
                input.focus();
                input.select();
                openDropdown();
            } else if (e.key === "Escape" && !dropdown.hidden) {
                closeDropdown();
            }
        });

        // Điều hướng mũi tên và Enter trong ô tìm kiếm
        input.addEventListener("keydown", (e) => {
            if (dropdown.hidden && (e.key === "ArrowDown" || e.key === "ArrowUp")) {
                openDropdown();
                performSearch();
                return;
            }

            if (dropdown.hidden) return;

            const total = currentResults.length;
            if (total === 0) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();
                selectedIndex = (selectedIndex + 1) % total;
                updateSelection();
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                selectedIndex = (selectedIndex - 1 + total) % total;
                updateSelection();
            } else if (e.key === "Enter") {
                if (selectedIndex >= 0 && selectedIndex < total) {
                    e.preventDefault();
                    const target = currentResults[selectedIndex];
                    if (target) {
                        window.location.href = target.item.url;
                    }
                }
            }
        });

        // Xử lý Tabs lọc (Tất cả, Bài học, Thuật ngữ)
        const tabs = root.querySelectorAll<HTMLButtonElement>("[data-filter-tab]");
        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                tabs.forEach((t) => {
                    t.classList.remove("is-active");
                    t.setAttribute("aria-selected", "false");
                });
                tab.classList.add("is-active");
                tab.setAttribute("aria-selected", "true");

                currentFilterTab = tab.dataset.filterTab || "all";
                // Ẩn thanh grade nếu chọn concept
                if (currentFilterTab === "concept") {
                    gradesBar.style.display = "none";
                } else {
                    gradesBar.style.display = "flex";
                }

                performSearch();
            });
        });

        // Xử lý Grade Chips lọc (Lớp 10, 11, 12)
        const gradeChips = root.querySelectorAll<HTMLButtonElement>("[data-grade-chip]");
        gradeChips.forEach((chip) => {
            chip.addEventListener("click", () => {
                gradeChips.forEach((c) => c.classList.remove("is-active"));
                chip.classList.add("is-active");
                currentFilterGrade = chip.dataset.gradeChip || "all";
                performSearch();
            });
        });

        // Xử lý gợi ý tìm kiếm
        const suggestionChips = root.querySelectorAll<HTMLButtonElement>("[data-suggestion]");
        suggestionChips.forEach((chip) => {
            chip.addEventListener("click", () => {
                const term = chip.dataset.suggestion || "";
                input.value = term;
                input.focus();
                performSearch();
            });
        });

        // Tải trước search index khi hover vào search bar để phản hồi tức thì
        root.addEventListener("mouseenter", ensureIndexLoaded, { once: true });
    }

    // Khởi tạo khi DOM sẵn sàng và hỗ trợ Astro View Transitions
    initSearchBox();
    document.addEventListener("astro:page-load", initSearchBox);
</script>
